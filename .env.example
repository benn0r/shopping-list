# Apple Developer team shown under Xcode > Settings > Accounts > Team Details.
IOS_DEVELOPMENT_TEAM=YOUR_TEAM_ID

# Required only by `npm run deploy`.
IOS_DEVICE_ID=YOUR_IPHONE_DEVICE_ID

# Required when Bring synchronization is enabled.
BRING_API_KEY=YOUR_BRING_CLIENT_KEY

# Hosted Shopping List Server used by Shopping List Cloud.
CLOUD_SERVER_URL=https://shopping-list.tueftli.com

# App Store Connect API (scripts/appstore-upload.sh); the .p8 key lives in
# ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8 and is never committed.
ASC_KEY_ID=
ASC_ISSUER_ID=
