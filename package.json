{
  "name": "shopping-list",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.12",
    "@expo/ui": "~57.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "expo": "~57.0.15",
    "expo-camera": "~57.0.4",
    "expo-glass-effect": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:release": "expo run:ios --device --configuration Release --no-build-cache",
    "web": "expo start --web",
    "lint": "expo lint . --max-warnings=0",
    "lint:fix": "expo lint . --fix",
    "check:expo": "expo install --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm run format && npm run lint:fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:local": "npm run build:web:e2e && npm run test:e2e",
    "test:e2e:ui": "npm run build:web:e2e && playwright test --ui",
    "test:coverage": "jest --runInBand tests/unit tests/integration --coverage",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:android:apk": "npm run prebuild:android && cd android && ./gradlew :app:assembleRelease --no-daemon",
    "build:ios": "expo export --platform ios --output-dir dist/ios --max-workers 1",
    "build:web:e2e": "cross-env EXPO_PUBLIC_E2E=1 expo export --platform web --output-dir dist/web --max-workers 1",
    "build": "npm run build:ios"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/tests/e2e/"
    ],
    "collectCoverageFrom": [
      "App.tsx",
      "src/**/*.{ts,tsx}",
      "!src/**/*.web.ts",
      "!src/types.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 90,
        "functions": 90,
        "lines": 95
      }
    }
  },
  "private": true
}
